  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled violet action per decision (套用這筆交易).",
      "html": "<button class=\"ds-btn ds-btn-primary\" type=\"button\">套用這筆交易</button>",
      "css": ".ds-btn{appearance:none;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:40px;padding:0 16px;border-radius:10px;cursor:pointer;font:600 14px/1.2 \"Noto Sans TC\",system-ui,sans-serif;transition:background-color .15s ease-out,border-color .15s ease-out,color .15s ease-out}.ds-btn-primary{background:#6927DA;border:1px solid #6927DA;color:#FFFFFF}.ds-btn-primary:hover{background:#5720BD;border-color:#5720BD}.ds-btn:focus-visible{outline:2px solid #6927DA;outline-offset:2px}@media (prefers-reduced-motion:reduce){.ds-btn{transition:none}}"
    },
    {
      "name": "Standard Button",
      "kind": "button",
      "refersTo": "button",
      "description": "White bordered key for every secondary action, with an optional 17px icon.",
      "html": "<button class=\"ds-btn2\" type=\"button\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 7.5L4.5 12 9 16.5M4.5 12H15a4.5 4.5 0 0 1 0 9h-2\"/></svg>復原這筆交易</button>",
      "css": ".ds-btn2{appearance:none;display:inline-flex;align-items:center;gap:6px;min-height:40px;padding:0 16px;border-radius:10px;cursor:pointer;background:#FFFFFF;color:#101318;border:1px solid #CFD4DC;box-shadow:0 1px 2px rgba(16,24,40,.05);font:600 14px/1.2 \"Noto Sans TC\",system-ui,sans-serif;transition:background-color .15s ease-out}.ds-btn2:hover{background:#F6F7F9}.ds-btn2:active{background:#ECEEF2}.ds-btn2:focus-visible{outline:2px solid #6927DA;outline-offset:2px}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Round toggle chips; pressed is violet, a pressed punt chip is red and struck through.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">PG</button><button class=\"ds-chip\" aria-pressed=\"false\">SG</button><button class=\"ds-chip ds-punt\" aria-pressed=\"true\">FT%</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:6px}.ds-chip{appearance:none;min-height:34px;padding:0 12px;border-radius:999px;cursor:pointer;background:#FFFFFF;color:#465062;border:1px solid #CFD4DC;font:700 13.5px/1 \"Sofia Sans Condensed\",\"Noto Sans TC\",sans-serif;letter-spacing:.03em}.ds-chip:hover{background:#F6F7F9;color:#101318}.ds-chip[aria-pressed=\"true\"]{background:#6927DA;border-color:#6927DA;color:#FFFFFF}.ds-chip.ds-punt[aria-pressed=\"true\"]{background:#FDECEA;border-color:#C01F14;color:#C01F14;text-decoration:line-through 1.5px}.ds-chip:focus-visible{outline:2px solid #6927DA;outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "40px bordered field with an inset icon; focus is a violet border plus a 3px violet ring.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6\"/><path d=\"M15 15l5 5\"/></svg><input placeholder=\"搜尋球員或球隊\"></label>",
      "css": ".ds-search{position:relative;display:inline-flex;width:300px;max-width:100%}.ds-search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);color:#626B7C}.ds-search input{width:100%;min-height:40px;padding:0 12px 0 36px;border-radius:10px;border:1px solid #CFD4DC;background:#FFFFFF;color:#101318;font:14px \"Noto Sans TC\",sans-serif}.ds-search input::placeholder{color:#626B7C}.ds-search input:focus{outline:none;border-color:#6927DA;box-shadow:0 0 0 3px rgba(105,39,218,.18)}"
    },
    {
      "name": "Bottom Bar",
      "kind": "nav",
      "refersTo": "nav-key-primary",
      "description": "Fixed on every width: the readout, then 聯盟 / 交易 / 球員 as 44px keys, 交易 filled violet.",
      "html": "<nav class=\"ds-bar\"><a class=\"ds-readout\" href=\"#\"><b>#1</b><span>5.7–3.3</span><b class=\"ds-up\">+$142/週</b></a><span class=\"ds-nav\"><a href=\"#\">聯盟</a><a class=\"ds-primary\" href=\"#\">交易</a><a href=\"#\">球員</a></span></nav>",
      "css": ".ds-bar{display:flex;align-items:center;gap:8px 12px;min-height:60px;padding:8px 16px;background:#FFFFFF;border-top:1px solid #E3E6EB;box-shadow:0 -2px 10px rgba(16,24,40,.06)}.ds-readout{display:flex;align-items:baseline;gap:2px 10px;min-height:44px;padding:0 8px;border-radius:10px;color:#101318;text-decoration:none;font:700 15px/1.2 \"Sofia Sans Condensed\",sans-serif;font-variant-numeric:tabular-nums;align-content:center;flex-wrap:wrap}.ds-readout b{font-size:20px;font-weight:800}.ds-up{color:#067647}.ds-nav{display:flex;gap:6px;margin-left:auto}.ds-nav a{display:inline-flex;align-items:center;justify-content:center;min-width:60px;min-height:44px;padding:0 14px;border-radius:10px;background:#F6F7F9;border:1px solid #E3E6EB;color:#101318;font:700 14px/1 \"Noto Sans TC\",sans-serif;text-decoration:none;transition:background-color .15s ease-out}.ds-nav a:hover{background:#ECEEF2}.ds-nav a.ds-primary{background:#6927DA;border-color:#6927DA;color:#FFFFFF}.ds-nav a.ds-primary:hover{background:#5720BD}.ds-nav a:focus-visible,.ds-readout:focus-visible{outline:2px solid #6927DA;outline-offset:2px}"
    },
    {
      "name": "Panel with title row",
      "kind": "card",
      "refersTo": "panel",
      "description": "White module with a 1px rule and the panel shadow; a title row with an optional slate note. Never nested.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-head\"><h2>聯盟戰力</h2><p>點一隊看名單和強弱項。</p></div><p class=\"ds-body\">表格內容</p></section>",
      "css": ".ds-panel{padding:20px 22px;background:#FFFFFF;border:1px solid #E3E6EB;border-radius:14px;box-shadow:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.06);color:#101318;font:15px/1.55 \"Noto Sans TC\",sans-serif}.ds-head{display:flex;flex-wrap:wrap;align-items:center;gap:6px 12px;margin-bottom:14px}.ds-head h2{margin:0;font:800 18px/1.3 \"Noto Sans TC\",sans-serif}.ds-head p{margin:0;flex:0 0 100%;font-size:13px;color:#465062}.ds-body{margin:0}"
    },
    {
      "name": "My Team Header",
      "kind": "custom",
      "refersTo": "rank-pill",
      "description": "Team name with the 我的 badge and rank pill, the record at 62px, $/week signed in green or red, then the nine-cell category strip.",
      "html": "<div class=\"ds-me\"><div class=\"ds-mh\"><h2>創沒有未來</h2><span class=\"ds-mine\">我的</span><span class=\"ds-pill ds-top\">第 <b>1</b> 名 / 14 隊</span></div><div class=\"ds-score\"><span class=\"ds-rec\">5.7–3.3</span><span class=\"ds-money\">+$142<small>/週</small></span></div><div class=\"ds-cats\"><span class=\"ds-cat ds-strong\"><i>PTS</i><b>2</b><s>前三</s></span><span class=\"ds-cat\"><i>REB</i><b>6</b><s></s></span><span class=\"ds-cat ds-weak\"><i>FT%</i><b>13</b><s>要補</s></span></div></div>",
      "css": ".ds-me{font-family:\"Noto Sans TC\",sans-serif;color:#101318}.ds-mh{display:flex;align-items:center;gap:8px 12px;flex-wrap:wrap}.ds-mh h2{margin:0;font:800 22px/1.3 \"Noto Sans TC\",sans-serif}.ds-mine{padding:2px 8px;border-radius:999px;background:#F3EEFF;color:#6927DA;box-shadow:inset 0 0 0 1px #D6C7FB;font:700 12px/1.35 \"Noto Sans TC\",sans-serif}.ds-pill{margin-left:auto;padding:4px 12px;border-radius:999px;background:#ECEEF2;color:#465062;font:600 13px/1.3 \"Noto Sans TC\",sans-serif}.ds-pill b{font:800 18px/1 \"Sofia Sans Condensed\",sans-serif;color:#101318}.ds-pill.ds-top{background:#F3EEFF;color:#6927DA}.ds-pill.ds-top b{color:#6927DA}.ds-score{display:flex;align-items:flex-end;gap:14px 36px;margin-top:12px;font-family:\"Sofia Sans Condensed\",sans-serif;font-variant-numeric:tabular-nums}.ds-rec{font:800 62px/.92 \"Sofia Sans Condensed\",sans-serif;letter-spacing:-.01em}.ds-money{font:800 36px/1 \"Sofia Sans Condensed\",sans-serif;color:#067647}.ds-money small{font-size:.56em}.ds-cats{display:grid;grid-template-columns:repeat(3,1fr);margin-top:18px;border-block:1px solid #E3E6EB}.ds-cat{display:grid;justify-items:center;gap:3px;padding:9px 0 8px;border-left:1px solid #E3E6EB}.ds-cat:first-child{border-left:0}.ds-cat i{font:700 12px/1.2 \"Sofia Sans Condensed\",sans-serif;font-style:normal;letter-spacing:.04em;color:#626B7C}.ds-cat b{font:800 26px/1 \"Sofia Sans Condensed\",sans-serif}.ds-cat s{min-height:17px;padding:1px 5px;text-decoration:none;font:700 11.5px/15px \"Noto Sans TC\",sans-serif}.ds-cat.ds-weak{background:#FDECEA}.ds-cat.ds-weak b,.ds-cat.ds-weak s{color:#C01F14}.ds-cat.ds-strong b,.ds-cat.ds-strong s{color:#1F55C2}"
    },
    {
      "name": "Heat Tiles",
      "kind": "custom",
      "refersTo": "heat-tile",
      "description": "The seven-step diverging scale, each step with its own text colour and the number printed in every tile.",
      "html": "<div class=\"ds-heat\"><span class=\"ds-c\" style=\"background:#1F55C2;color:#FFFFFF\"><i>+2.4</i></span><span class=\"ds-c\" style=\"background:#6E98E6;color:#0D1F42\"><i>+1.3</i></span><span class=\"ds-c\" style=\"background:#CBDBF7;color:#0D1F42\"><i>+0.5</i></span><span class=\"ds-c\" style=\"background:#ECEEF2;color:#101318\"><i>0.0</i></span><span class=\"ds-c\" style=\"background:#F7D4D0;color:#3D1311\"><i>−0.6</i></span><span class=\"ds-c\" style=\"background:#E8857C;color:#2B0B09\"><i>−1.2</i></span><span class=\"ds-c\" style=\"background:#C01F14;color:#FFFFFF\"><i>−2.1</i></span><span class=\"ds-c ds-off\"><i>FT%</i></span></div>",
      "css": ".ds-heat{display:grid;grid-template-columns:repeat(8,34px);gap:3px}.ds-c{display:grid;place-items:center;min-height:30px;border-radius:6px;cursor:default}.ds-c i{font:700 14px/1 \"Sofia Sans Condensed\",sans-serif;font-style:normal;font-variant-numeric:tabular-nums}.ds-c:hover{outline:2px solid #101318;outline-offset:1px}.ds-c.ds-off{background:transparent;color:#626B7C;outline:1px dashed #CFD4DC;outline-offset:-1px}.ds-c.ds-off i{text-decoration:line-through}"
    },
    {
      "name": "Trade Verdict and Swings",
      "kind": "custom",
      "refersTo": "player-chip",
      "description": "The signature box score: removable player chips, the signed weekly $ verdict, and the category swings as headline cells.",
      "html": "<div class=\"ds-deal\"><button class=\"ds-pc\"><span>Jalen Duren</span><small>C · 估值 $14</small><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6.5 6.5l11 11M17.5 6.5l-11 11\"/></svg></button><div class=\"ds-v\"><span>換完你每週</span><b>+$24</b><em>整季 +$480</em></div><div class=\"ds-dc\"><span class=\"ds-pos ds-big\"><b>REB</b><i>+9</i><s>→ 71%</s></span><span class=\"ds-neg\"><b>FT%</b><i>−4</i><s>→ 38%</s></span><span><b>PTS</b><i>±0</i><s>→ 55%</s></span></div></div>",
      "css": ".ds-deal{display:grid;gap:12px;max-width:360px;font-family:\"Noto Sans TC\",sans-serif;color:#101318}.ds-pc{appearance:none;display:grid;grid-template-columns:1fr 16px;align-items:center;gap:1px 8px;min-height:44px;padding:6px 8px 6px 10px;border-radius:10px;background:#FFFFFF;border:1px solid #CFD4DC;text-align:left;cursor:pointer;font:700 14px/1.25 \"Noto Sans TC\",sans-serif;transition:border-color .15s ease-out}.ds-pc small{grid-column:1;font:600 12.5px/1.2 \"Sofia Sans Condensed\",sans-serif;color:#626B7C}.ds-pc svg{grid-column:2;grid-row:1/span 2;color:#626B7C}.ds-pc:hover{border-color:#C01F14}.ds-pc:hover svg{color:#C01F14}.ds-v{display:flex;flex-wrap:wrap;align-items:baseline;gap:2px 12px;color:#067647}.ds-v span{flex-basis:100%;font:700 13px/1.3 \"Noto Sans TC\",sans-serif;color:#465062}.ds-v b{font:800 46px/1 \"Sofia Sans Condensed\",sans-serif}.ds-v em{font:700 17px/1 \"Sofia Sans Condensed\",sans-serif;font-style:normal}.ds-dc{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}.ds-dc>span{display:grid;justify-items:center;gap:3px;padding:7px 0 6px;border-radius:8px;background:#F6F7F9}.ds-dc b{font:700 11px/1 \"Sofia Sans Condensed\",sans-serif;letter-spacing:.03em;color:#626B7C}.ds-dc i{font:800 17px/1 \"Sofia Sans Condensed\",sans-serif;font-style:normal;color:#465062}.ds-dc s{text-decoration:none;font:600 13.5px/1 \"Sofia Sans Condensed\",sans-serif;color:#465062}.ds-dc .ds-pos i{color:#067647}.ds-dc .ds-neg i{color:#C01F14}.ds-dc .ds-pos.ds-big{background:#E6F5EC}"
    },
    {
      "name": "Tags and Grades",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Pill tags in neutral, win, over and risk variants; grades in ink (S solid, A outline).",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag ds-target\">值得搶</span><span class=\"ds-tag ds-over\">易溢價</span><span class=\"ds-tag ds-risk\">出賽風險</span><span class=\"ds-tag\">適合 punt FT%</span><span class=\"ds-g ds-gS\">S</span><span class=\"ds-g ds-gA\">A</span><span class=\"ds-g\">B</span></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:6px;align-items:center}.ds-tag{display:inline-flex;padding:1px 7px;border-radius:999px;background:#ECEEF2;color:#465062;font:700 11.5px/1.35 \"Noto Sans TC\",sans-serif}.ds-tag.ds-target{background:#E6F5EC;color:#067647}.ds-tag.ds-over{background:#FDECEA;color:#C01F14}.ds-tag.ds-risk{background:transparent;color:#C01F14;box-shadow:inset 0 0 0 1px #C01F14}.ds-g{min-width:22px;padding:3px 5px;border-radius:6px;text-align:center;font:800 12.5px/1 \"Sofia Sans Condensed\",sans-serif;background:#ECEEF2;color:#465062}.ds-g.ds-gS{background:#101318;color:#FFFFFF}.ds-g.ds-gA{background:transparent;color:#101318;box-shadow:inset 0 0 0 1.5px #101318}"
    }
  ],
  "narrative": {
    "northStar": "The Box Score, Played Straight",
    "overview": "**Creative North Star: \"The Box Score, Played Straight\"**\n\nThe page is the category-standard fantasy-sports data app at the craft level of Yahoo Fantasy, Sleeper, ESPN Fantasy and Basketball Monster, borrowing none of their branding, logos, colours-as-identity or layouts. There is no metaphor and no costume: white modules on a cool grey page, a near-black ink, one violet accent, and a condensed tabular face for every number. Judgement is carried by colour and plain labels (green / red money with a sign, a blue-to-red diverging scale on the nine categories, 要補 / 前三 labels), never by decoration.\n\nDensity is high and orderly. League, roster and player data sit in aligned rows and columns with fixed tracks so numbers compare vertically; nothing the owner checks often hides behind extra taps or nested panels. The dark theme is the same app on a near-black page with charcoal panels and lighter tints, not a different world. Motion is state change only.\n\nThe 2026-10-02 owner decision retired the previous tactics-board look; nothing from it (magnets, label tape, marker inks, handwriting face, aluminium chrome) is part of this system.",
    "keyCharacteristics": [
      "Cool grey page, white panels with a 1px rule and a faint shadow; charcoal on near-black in dark.",
      "One violet accent: primary actions, selection, focus and my team.",
      "Every number in Sofia Sans Condensed with tabular figures; Noto Sans TC for all text.",
      "Money in green / red with an explicit + / − sign.",
      "A seven-step blue-to-red diverging scale for category heat and ranks, with the number printed in every tile.",
      "Aligned rows and columns for all data; a fixed bottom bar on every width."
    ],
    "rules": [
      {
        "name": "The One Violet Rule",
        "body": "Violet means \"act here\" or \"this is mine\": primary action, selection, focus, my team. It never colours a grade, a category, money or decoration.",
        "section": "colors"
      },
      {
        "name": "The Signed Money Rule",
        "body": "Money is up or down with an explicit + or − in front of the figure; the colour never carries the sign alone.",
        "section": "colors"
      },
      {
        "name": "The Printed Number Rule",
        "body": "Every heat or rank tile prints its number. Colour ranks the cell; the number is the data.",
        "section": "colors"
      },
      {
        "name": "The Ink Grade Rule",
        "body": "Grades are ink, not accent: S is a solid ink tile with panel-coloured text, A is an ink outline, B–D sit on Pill Grey.",
        "section": "colors"
      },
      {
        "name": "The Two Faces Rule",
        "body": "Noto Sans TC for every word, Sofia Sans Condensed tabular for every number, including the numbers in buttons, pills and the bottom readout. No handwriting, display or script face.",
        "section": "typography"
      },
      {
        "name": "The Aligned Rows Rule",
        "body": "League, roster and player data are rows on one shared grid with fixed tracks and 1px rules between them, never separate cards and never `auto` tracks that size per row.",
        "section": "layout"
      },
      {
        "name": "The No-Nesting Rule",
        "body": "A panel never sits inside a panel. Sub-sections inside a panel are separated by a 1px rule and a small heading, not by another bordered, shadowed box.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep violet for primary actions, selection, focus and my team only (The One Violet Rule).",
      "**Do** print every figure in the number face with tabular figures, and every money figure with an explicit + or −, in up / down.",
      "**Do** print the number inside every heat and rank tile, using that step's own text colour.",
